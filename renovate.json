{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "bump",
  "ignorePaths": ["terraform/**"],
  "packageRules": [
    {
      "description": "Group and automerge safe npm non-major updates after CI",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Do not automerge major npm updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Do not automerge ffmpeg packages",
      "matchPackageNames": ["@ffmpeg/ffmpeg", "@ffmpeg/core", "@ffmpeg/util"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "groupName": "ffmpeg packages"
    },
    {
      "description": "Do not automerge Next.js/React major framework packages",
      "matchPackageNames": ["next", "react", "react-dom", "eslint-config-next"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group and automerge GitHub Actions non-major updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}

# Local development / Docker
# Authentication remains required unless explicitly disabled.
NEXT_PUBLIC_AUTH_REQUIRED=false
APP_PORT=3000

# Developer-only local transcription prototype. No production transcription UI is enabled by this flag alone.
NEXT_PUBLIC_LOCAL_TRANSCRIPTION_PROTOTYPE=false

# Cognito/profile values are only required when NEXT_PUBLIC_AUTH_REQUIRED=true.
NEXT_PUBLIC_COGNITO_DOMAIN=https://YOUR-PREFIX.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback/
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000/login/
NEXT_PUBLIC_PROFILE_API_BASE_URL=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com
